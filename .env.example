# rules: 无需密钥的有限中文规划模式；llm: 使用真实模型生成受校验的业务计划。
# 只有填齐 LLM_* 三项（地址、密钥、模型名）才会真正启用模型模式；
# 任何一项缺失都会整体回退到规则模式（健康接口与界面徽章如实显示），
# 不会出现"以为在测模型、实际在用规则"的假象。
AGENT_MODE=llm
# 初赛评审跑测模型：阿里云百炼 Qwen3.8-Max（OpenAI 兼容模式）。
# 模型 ID 以服务商控制台为准；任何兼容 Chat Completions 的服务均可接入。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-max
# 模型规划失败（服务异常/输出无效）时是否回退规则解析并在结果中明确标注。1=回退，0=直接失败。
LLM_FALLBACK_RULES=1
QUERY_TIMEOUT_SECONDS=45
RUN_TIMEOUT_SECONDS=120
# 默认从项目父目录查找本题 Excel 和 CSV 压缩包。
# SOURCE_ROOT=D:/项目
